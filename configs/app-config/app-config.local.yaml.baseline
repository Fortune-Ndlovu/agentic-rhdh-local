integrations:
  github:
  - host: github.com
    token: ${GITHUB_TOKEN}
auth:
  providers:
    github:
      development:
        clientId: ${AUTH_GITHUB_CLIENT_ID}
        clientSecret: ${AUTH_GITHUB_CLIENT_SECRET}
        signIn:
          resolvers:
          - resolver: usernameMatchingUserEntityName
backend:
  csp:
    img-src:
    - '''self'''
    - 'data:'
    - https://avatars.githubusercontent.com
    - https://quay.io
    - https://*.quay.io
techdocs:
  builder: local
  generator:
    runIn: local
  publisher:
    type: local
